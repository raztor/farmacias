# apps/server — Fastify + tRPC + Better Auth (docs/ARCHITECTURE.md → Variables de entorno).
# `pnpm run setup` copia este archivo a .env y genera los valores marcados como secreto aleatorio.

NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000

DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# 32+ caracteres aleatorios (firma cookies y tokens de sesión).
BETTER_AUTH_SECRET=change-me
# URL pública de esta API.
BETTER_AUTH_URL=http://localhost:4000
# Orígenes permitidos (CORS + Better Auth), separados por coma: web de la app (Expo, :8081),
# admin (:3001) y bnp:// (app iOS/Android).
TRUSTED_ORIGINS=http://localhost:8081,http://localhost:3001,bnp://

# Proxies/balanceadores delante de la API (0 si se expone directo). Define la IP del cliente.
TRUST_PROXY_HOPS=1
# Alternativa por dirección (reemplaza a TRUST_PROXY_HOPS): rangos con nombre (loopback,
# linklocal, uniquelocal), IPs o CIDR separados por coma. En producción con compose:
# TRUST_PROXY_ADDRESSES=loopback,uniquelocal

# Solicitudes por minuto y por IP.
RATE_LIMIT_MAX=300

# Opcionales: errores (Sentry) y trazas (OTLP/HTTP, p. ej. http://localhost:4318).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# `pnpm db:seed`: crea las cuentas sintéticas preinscritas (no hay registro público):
# residente1..3@demo.farmacia.cl (resident), operador@demo.farmacia.cl (operator) y
# admin@demo.farmacia.cl (admin). Contraseñas SINTÉTICAS solo para desarrollo y demo (mínimo
# 8 caracteres); cámbialas en cualquier entorno compartido. El seed no cambia la contraseña de
# una cuenta que ya existe.
SEED_RESIDENT_PASSWORD=Vecino-Demo-2026
SEED_OPERATOR_PASSWORD=Operador-Demo-2026
SEED_ADMIN_PASSWORD=Admin-Demo-2026
