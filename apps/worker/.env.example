# apps/worker — consume las colas BullMQ (emails). `pnpm run setup` copia este archivo a .env.
# Ver docs/ARCHITECTURE.md → Variables de entorno.

NODE_ENV=development
LOG_LEVEL=info

# Infraestructura (ver docker-compose.yml).
REDIS_URL=redis://localhost:6379
# Se valida al iniciar aunque hoy ningún job usa la base de datos.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Envío de emails (en desarrollo Mailpit: bandeja en http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="App <no-reply@app.local>"

# Jobs procesados en paralelo por cola y puerto del endpoint /health.
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4100

# Opcionales: errores (Sentry) y trazas (OTLP/HTTP, p. ej. http://localhost:4318).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
