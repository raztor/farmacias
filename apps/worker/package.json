{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env --import ./dist/instrument.js dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo node_modules dist coverage"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/shared": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "nodemailer": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
