# apps/admin (Next.js, backoffice para los roles `operator` y `admin`). `pnpm run setup` copia este archivo a .env.
# Ver docs/ARCHITECTURE.md → Variables de entorno.

# URL interna de la API (apps/server). Next.js reescribe /api/auth/* y /trpc/* hacia ella.
# Se resuelve en el build (rewrites): debe estar definida al ejecutar `next build`.
# El servidor debe incluir http://localhost:3001 en TRUSTED_ORIGINS.
API_INTERNAL_URL=http://localhost:4000

# App de vecinos (web export de Expo), enlazada desde la página «Sin acceso» (opcional).
RESIDENT_APP_URL=http://localhost:8081

# Sentry (opcional). Sin DSN, Sentry no se inicializa.
NEXT_PUBLIC_SENTRY_DSN=

# Subida de source maps a Sentry (opcional, solo en CI/build). Sin token no se sube nada.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Omite la validación de variables en el build (p. ej. imágenes Docker). No usar en runtime.
# SKIP_ENV_VALIDATION=1
