    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-native-web-vite": "catalog:",
    "@types/react": "catalog:",
    "autoprefixer": "catalog:",
    "eslint": "catalog:",
    "nativewind": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:",
