# Variables públicas de la app (Expo las incrusta en el bundle: NO pongas secretos aquí).

# URL del API (apps/server).
# - Simulador iOS / web en desarrollo (expo start --web, :8081): http://localhost:4000
# - Web en producción (Dockerfile.web): vacía = mismo origen (Caddy hace de proxy de /api/auth y /trpc)
# - Emulador Android: http://10.0.2.2:4000 (10.0.2.2 apunta al localhost del computador)
# - Dispositivo físico: la IP de tu computador en la red local, p. ej. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# DSN de Sentry (opcional). Vacío = Sentry desactivado.
EXPO_PUBLIC_SENTRY_DSN=

# --- Solo en build (app.config.ts / EAS) ---
# ID del proyecto EAS (lo entrega `eas init`). Necesario para EAS Build / EAS Update.
EAS_PROJECT_ID=
