# Serves the web export of the Expo app (`expo export --platform web`, see Dockerfile.web).
#
# - Single-page app: unknown paths fall back to /index.html (Expo Router resolves them).
# - Hashed bundles and assets (/_expo/static/*, /assets/*) are cached for a year; the HTML is
#   always revalidated so a deploy is picked up on the next load.
# - /api/auth/* and /trpc/* are proxied to the API, so the browser only talks to this origin and
#   the Better Auth session cookie is first-party (no CORS, SameSite=Lax works).
#
# Env: PORT (default 8080), API_UPSTREAM (default http://server:4000).
{
	admin off
	auto_https off
	persist_config off
	# TLS terminates at the reverse proxy in front of this container: trust its X-Forwarded-*.
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	root * /srv

	# Liveness for the container HEALTHCHECK / orchestrator (does not touch the API).
	handle /health {
		respond "ok" 200
	}

	@api path /api/auth/* /trpc/*
	handle @api {
		# Appends X-Forwarded-For/-Proto/-Host. Host is set to the upstream's name because the
		# Azure Container Apps ingress routes by Host (the public Host would loop back to this app).
		reverse_proxy {$API_UPSTREAM:http://server:4000} {
			header_up Host {http.reverse_proxy.upstream.host}
		}
	}

	# Content-hashed files: cached for a year. A missing one is a plain 404 (never cached and
	# never answered with index.html, which would hide a broken deploy).
	@hashed path /_expo/static/* /assets/*
	handle @hashed {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a client-side route of the SPA.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
