{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["expo/tsconfig.base", "@repo/tsconfig/react-library.json"],
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "customConditions": ["react-native"],
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "allowJs": false,
    "types": ["expo/types"]
  },
  "include": ["src", "*.ts", "nativewind-env.d.ts"]
}
