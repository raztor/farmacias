# Build context for apps/*/Dockerfile and docker/*.Dockerfile (always built from the repo root).
# Dependencies, build outputs and secrets are produced inside the image, never copied from the host.

# VCS and editor/OS files
.git
.github
.husky
.vscode
.idea
**/.DS_Store
**/*.log

# Dependencies
**/node_modules
**/.pnpm-store

# Build outputs and caches
**/dist
**/build
**/.next
**/out
**/.turbo
**/.cache
**/.eslintcache
**/*.tsbuildinfo
**/storybook-static
**/dist-export
**/coverage
**/test-results
**/playwright-report
**/blob-report

# Generated Prisma client (regenerated by `db:generate` inside the image)
packages/db/src/generated

# Workspaces that are not deployed as containers. apps/mobile stays in the context for its web
# build (apps/mobile/Dockerfile.web); its native projects ship through EAS and are excluded.
apps/storybook
apps/e2e
apps/mobile/ios
apps/mobile/android
**/.expo
**/.expo-shared
**/.maestro

# Environment files and secrets (only the .env.example templates are allowed)
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.mobileprovision
.sentryclirc

# Docker files themselves do not need to be in the context
**/Dockerfile
**/Dockerfile.*
**/*.Dockerfile
docker-compose*.yml
.dockerignore
