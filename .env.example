# Variables de los servicios de desarrollo (docker-compose.yml: PostgreSQL, Redis, Mailpit).
# `pnpm run setup` copia este archivo a .env. Las variables de cada app viven en apps/*/.env.example.
#
# Deben coincidir con DATABASE_URL de las apps (docs/ARCHITECTURE.md → Variables de entorno):
#   DATABASE_URL=postgresql://app:app@localhost:5432/app
#   REDIS_URL=redis://localhost:6379
#   SMTP_URL=smtp://localhost:1025

# PostgreSQL 18
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# Redis 8
REDIS_PORT=6379

# Mailpit (SMTP para desarrollo + bandeja web en http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
