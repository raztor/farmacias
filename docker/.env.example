# Variables for docker-compose.prod.yml (see docs/DEPLOYMENT.md).
#
#   cp docker/.env.example docker/.env      # docker/.env is ignored by git and by .dockerignore
#   docker compose --env-file docker/.env -f docker-compose.prod.yml up -d --build
#
# Each service only receives the variables it needs (compose interpolation, not a shared env_file).

# --- Images -----------------------------------------------------------------------------------
IMAGE_PREFIX=farmacias
IMAGE_TAG=latest

# --- PostgreSQL / Redis (internal network, not published) --------------------------------------
POSTGRES_USER=app
# Required. Use a long random value (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=
POSTGRES_DB=app

# --- Published ports (put a TLS reverse proxy in front of them) --------------------------------
# Server and admin listen on 127.0.0.1 only: the TLS reverse proxy runs on the same host.
SERVER_PORT=4000
ADMIN_PORT=3001
# Web build of the Expo resident app (Caddy; proxies /api/auth and /trpc to the server).
MOBILE_WEB_PORT=8080
# Worker /health, published on 127.0.0.1 only (host-side monitoring).
WORKER_PORT=4100
# Mailpit inbox (only with `--profile demo`, 127.0.0.1 only).
MAILPIT_UI_PORT=8025

# --- Shared by server and worker ----------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Server (apps/server) ----------------------------------------------------------------------
# Required: 32+ random characters (`openssl rand -base64 48`).
BETTER_AUTH_SECRET=
# Public URL of the API (what browsers and the mobile app reach).
BETTER_AUTH_URL=https://api.farmacia.example.cl
# Comma-separated: public URLs of the resident web app (mobile-web) and admin, plus bnp:// for
# the iOS/Android app.
TRUSTED_ORIGINS=https://farmacia.example.cl,https://admin.farmacia.example.cl,bnp://
TRUST_PROXY_HOPS=1
# Trusted proxies by address (overrides TRUST_PROXY_HOPS): containers and the host proxy.
TRUST_PROXY_ADDRESSES=loopback,uniquelocal
RATE_LIMIT_MAX=300

# --- Worker (apps/worker) ----------------------------------------------------------------------
# Required: real SMTP provider (smtps:// for TLS), e.g. smtps://user:pass@smtp.example.com:465
# Demo/staging with `--profile demo`: SMTP_URL=smtp://mailpit:1025 (inbox at http://localhost:8025).
SMTP_URL=
EMAIL_FROM="Farmacia Comunitaria Peñalolén <no-reply@farmacia.example.cl>"
WORKER_CONCURRENCY=5

# --- Admin (Next.js) and mobile-web (Expo web export) ------------------------------------------
# Admin runtime: public URL of the resident web app, linked from the «Sin acceso» page.
RESIDENT_APP_URL=https://farmacia.example.cl
# Inlined in the browser bundles at build time (rebuild the images after changing them).
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
